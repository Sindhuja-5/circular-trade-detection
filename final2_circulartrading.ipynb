    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import networkx as nx\n",
        "from itertools import combinations\n",
        "from node2vec import Node2Vec\n",
        "from sklearn.cluster import KMeans"
      ],
      "metadata": {
        "id": "emj1DnTdcvy8"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "trade_graph = nx.MultiDiGraph()\n",
        "with open('Iron_dealers_data.csv', 'r') as f:\n",
        "    next(f) # skip header\n",
        "    for line in f:\n",
        "        seller_id, buyer_id, value = line.strip().split(',')\n",
        "        trade_graph.add_edge(seller_id, buyer_id, value=float(value))\n"
      ],
      "metadata": {
        "id": "GjKvJUO6c3PO"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "df = pd.read_csv('Iron_dealers_data.csv')\n",
        "num_rows, num_cols = df.shape\n",
        "\n",
        "print('Number of rows:', num_rows)\n",
        "print('Number of columns:', num_cols)\n",
        "head = df.head(10)\n",
        "\n",
        "# Print the head\n",
        "print(head)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "nteQak5t8Mix",
        "outputId": "3238ac19-7577-4a6a-8afb-9f63a890a66b"
