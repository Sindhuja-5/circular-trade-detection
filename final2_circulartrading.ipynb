    {
      "cell_type": "code",
      "source": [
        "# Identify circular trade patterns within clusters\n",
        "for i in range(6):\n",
        "    cluster_nodes = [node  for node in trade_graph.nodes() if clusters[int(label_dict[node])] == i]   \n",
        "    for node1 in cluster_nodes:\n",
        "       for node2 in cluster_nodes:\n",
        "            if node1 >= node2:\n",
        "               continue\n",
        "            trades = trade_graph.get_edge_data(node1, node2)           \n",
        "            if trades:\n",
        "                node1_sales=0\n",
        "                node2_sales=0\n",
        "                total_value=0\n",
        "                for trade in trades:\n",
        "                    value = trades[trade]['value']\n",
        "                    total_value += value\n",
        "                i=0\n",
        "                prev_num=0\n",
        "                for trade in trade_graph.edges(node1):\n",
        "                    edgedata = trade_graph.get_edge_data(trade[0],trade[1])\n",
        "                    if prev_num!=len(edgedata) :\n",
        "                       prev_num=len(edgedata)\n",
        "                       i=0                  \n",
        "                    if i<len(edgedata) :\n",
        "                         node1_sales += edgedata[i]['value']\n",
        "                         i=i+1\n",
        "                    else :\n",
        "                      i=0\n",
        "                      node1_sales += edgedata[i]['value']\n",
        "                      i=i+1\n",
        "                i=0  \n",
        "                prev_num=0\n",
        "                for trade in trade_graph.edges(node2):\n",
        "                    edgedata = trade_graph.get_edge_data(trade[0],trade[1])\n",
        "                    if prev_num!=len(edgedata) :\n",
        "                       prev_num=len(edgedata)\n",
        "                       i=0                  \n",
        "                    if i<len(edgedata) :\n",
        "                         node2_sales += edgedata[i]['value']\n",
        "                         i=i+1\n",
        "                    else :\n",
        "                      i=0\n",
        "                      node2_sales += edgedata[i]['value']\n",
        "                      i=i+1     \n",
        "                if total_value > 0.5 * node1_sales and total_value > 0.5 * node2_sales:\n",
        "                    print(f\"Circular trade detected between {node1} and {node2}\")\n"
      ],
