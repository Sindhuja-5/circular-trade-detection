    {
      "cell_type": "code",
      "source": [
        "unique_numbers = np.unique(trade_graph.nodes())\n",
        "unique_labels = np.arange(0, len(unique_numbers))\n",
        "label_dict = dict(zip(unique_numbers, unique_labels))\n"
      ],
      "metadata": {
        "id": "zttYI1Sye12B"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "node2vec = Node2Vec(trade_graph, dimensions=64, walk_length=30, num_walks=200, workers=4)\n",
        "embeddings = node2vec.fit()\n",
        "embeddings1 = np.array([embeddings.wv[str(node)] for node in trade_graph.nodes()])\n",
        "kmeans = KMeans(n_clusters=6)\n",
        "clusters = kmeans.fit_predict(embeddings1)\n"
      ],
      "metadata": {
